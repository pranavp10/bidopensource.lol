
# PRODUCTION ENVIRONMENT VARIABLES (For Vercel / Production)

# 1. PostgreSQL Database Connection URL
DATABASE_URL="postgresql://user:password@your-postgres-host:5432/bidopensource?sslmode=require"

# 2. Dodo Payments (Live Mode - From Dashboard when toggle is LIVE)
DODO_PAYMENTS_API_KEY="your_live_api_key_here"
DODO_PAYMENTS_WEBHOOK_SECRET="your_live_webhook_signing_secret_here"
DODO_PAYMENTS_PRODUCT_ID="your_live_product_id_here"
DODO_PAYMENTS_ENVIRONMENT="live_mode"

# 3. Base App URL
NEXT_PUBLIC_APP_URL="https://www.bidopensource.lol"
